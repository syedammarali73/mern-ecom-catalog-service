{
    "name": "catalog-service",
    "version": "1.0.0",
    "description": "A catalog management service",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "format:fix": "prettier src --write",
        "format:check": "prettier src --check",
        "lint:check": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache --coverage --all --runInBand",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --runInBand",
        "prepare": "husky"
    },
    "author": "Syed Ammar Ali <syedammarali73@gmail.com>",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.0",
        "@types/supertest": "^7.2.0",
        "@types/winston": "^2.4.4",
        "eslint": "^10.2.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "3.8.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "dependencies": {
        "config": "^4.4.2",
        "cookie-parser": "^1.4.7",
