        "http-errors": "^2.0.1",
        "jose": "^6.2.3",
        "js-yaml": "^5.2.1",
        "jwks-rsa": "^2.1.5",
        "mock-jwks": "^2.1.1",
        "mongoose": "^9.7.4",
        "nock": "^13.5.6",
        "supertest": "^7.2.2",
        "uuid": "^14.0.1",
        "winston": "^3.19.0"
